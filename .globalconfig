# Not applicable in this template-pack repo: fleet-synced from repo-template for the
# repo's own (code-free) *.template.pack.csproj projects. It is outside every Content/
# folder, so it never reaches a generated app. Kept so template syncs stay clean; see
# docs/adr/0004-template-pack-ci-adaptations.md.

is_global = true

# Global analyzer configuration
global_level = 9999

# Roslynator configuration
roslynator_accessibility_modifiers = explicit
roslynator_enum_has_flag_style = method
roslynator_object_creation_type_style = implicit_when_type_is_obvious
roslynator_use_anonymous_function_or_method_group = method_group
